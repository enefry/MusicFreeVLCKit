+        if (filter->ops != NULL && filter->ops->close != NULL)
+            filter->ops->close(filter);
+        var_Destroy(filter, "module-name");
+        filter->p_module = NULL;
+    }
+    vlc_objres_clear(&filter->obj);
+}

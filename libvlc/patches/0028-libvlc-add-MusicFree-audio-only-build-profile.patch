diff --git a/contrib/src/ffmpeg/musicfree-audio-only.patch b/contrib/src/ffmpeg/musicfree-audio-only.patch
new file mode 100644
index 0000000000..1090507081
--- /dev/null
+++ b/contrib/src/ffmpeg/musicfree-audio-only.patch
@@ -0,0 +1,225 @@
+--- a/libavcodec/codec_desc.c
++++ b/libavcodec/codec_desc.c
+@@ -32,6 +32,7 @@
+ #define MT(...) (const char *const[]){ __VA_ARGS__, NULL }
+ 
+ static const AVCodecDescriptor codec_descriptors[] = {
++#ifndef MUSICFREE_AUDIO_PROFILE
+     /* video codecs */
+     {
+         .id        = AV_CODEC_ID_MPEG1VIDEO,
+@@ -2797,6 +2798,7 @@
+         .props     = AV_CODEC_PROP_INTRA_ONLY | AV_CODEC_PROP_LOSSY,
+     },
+ 
++#endif
+     /* audio codecs */
+     {
+         .id        = AV_CODEC_ID_MP2,
+@@ -3568,6 +3570,7 @@
+         .props     = AV_CODEC_PROP_INTRA_ONLY | AV_CODEC_PROP_LOSSY,
+     },
+ 
++#ifndef MUSICFREE_AUDIO_PROFILE
+     /* subtitle codecs */
+     {
+         .id        = AV_CODEC_ID_DVD_SUBTITLE,
+@@ -3869,6 +3872,7 @@
+         .name      = "vnull",
+         .long_name = NULL_IF_CONFIG_SMALL("Null video codec"),
+     },
++#endif
+     {
+         .id        = AV_CODEC_ID_ANULL,
+         .type      = AVMEDIA_TYPE_AUDIO,
+--- a/libavformat/rawdec.c
++++ b/libavformat/rawdec.c
+@@ -65,6 +65,8 @@
+     return 0;
+ }
+ 
++#define DEC AV_OPT_FLAG_DECODING_PARAM
++#ifndef MUSICFREE_AUDIO_PROFILE
+ /* MPEG-1/H.263 input */
+ int ff_raw_video_read_header(AVFormatContext *s)
+ {
+@@ -92,6 +94,8 @@
+     return ret;
+ }
+ 
++#endif
++#ifndef MUSICFREE_AUDIO_PROFILE
+ int ff_raw_subtitle_read_header(AVFormatContext *s)
+ {
+     AVStream *st = avformat_new_stream(s, NULL);
+@@ -102,6 +106,7 @@
+     st->start_time = 0;
+     return 0;
+ }
++#endif
+ 
+ static int raw_data_read_header(AVFormatContext *s)
+ {
+@@ -114,10 +119,10 @@
+     return 0;
+ }
+ 
++#ifndef MUSICFREE_AUDIO_PROFILE
+ /* Note: Do not forget to add new entries to the Makefile as well. */
+ 
+ #define OFFSET(x) offsetof(FFRawVideoDemuxerContext, x)
+-#define DEC AV_OPT_FLAG_DECODING_PARAM
+ static const AVOption rawvideo_options[] = {
+     { "framerate", "", OFFSET(framerate), AV_OPT_TYPE_VIDEO_RATE, {.str = "25"}, 0, INT_MAX, DEC},
+     { "raw_packet_size", "", OFFSET(raw_packet_size), AV_OPT_TYPE_INT, {.i64 = RAW_PACKET_SIZE }, 1, INT_MAX, DEC},
+@@ -132,6 +137,7 @@
+     .version    = LIBAVUTIL_VERSION_INT,
+ };
+ 
++#endif
+ #define OFFSET(x) offsetof(FFRawDemuxerContext, x)
+ static const AVOption raw_options[] = {
+     { "raw_packet_size", "", OFFSET(raw_packet_size), AV_OPT_TYPE_INT, {.i64 = RAW_PACKET_SIZE }, 1, INT_MAX, DEC},
+--- a/libavformat/oggdec.h
++++ b/libavformat/oggdec.h
+@@ -127,9 +127,11 @@
+ extern const struct ogg_codec ff_dirac_codec;
+ extern const struct ogg_codec ff_flac_codec;
+ extern const struct ogg_codec ff_ogm_audio_codec;
++#ifndef MUSICFREE_AUDIO_PROFILE
+ extern const struct ogg_codec ff_ogm_old_codec;
+ extern const struct ogg_codec ff_ogm_text_codec;
+ extern const struct ogg_codec ff_ogm_video_codec;
++#endif
+ extern const struct ogg_codec ff_old_dirac_codec;
+ extern const struct ogg_codec ff_old_flac_codec;
+ extern const struct ogg_codec ff_opus_codec;
+--- a/libavformat/oggdec.c
++++ b/libavformat/oggdec.c
+@@ -53,10 +53,14 @@
+     &ff_vp8_codec,
+     &ff_old_dirac_codec,
+     &ff_old_flac_codec,
++#ifndef MUSICFREE_AUDIO_PROFILE
+     &ff_ogm_video_codec,
++#endif
+     &ff_ogm_audio_codec,
++#ifndef MUSICFREE_AUDIO_PROFILE
+     &ff_ogm_text_codec,
+     &ff_ogm_old_codec,
++#endif
+     NULL
+ };
+ 
+@@ -930,11 +934,13 @@
+            && !ogg_packet(s, &i, &pstart, &psize, pos_arg)) {
+         if (i == stream_index) {
+             struct ogg_stream *os = ogg->streams + stream_index;
++#ifndef MUSICFREE_AUDIO_PROFILE
+             // Do not trust the last timestamps of an ogm video
+             if (    (os->flags & OGG_FLAG_EOS)
+                 && !(os->flags & OGG_FLAG_BOS)
+                 && os->codec == &ff_ogm_video_codec)
+                 continue;
++#endif
+             pts = ogg_calc_pts(s, i, NULL);
+             ogg_validate_keyframe(s, i, pstart, psize);
+             if (os->pflags & AV_PKT_FLAG_KEY) {
+--- a/libavformat/oggparseogm.c
++++ b/libavformat/oggparseogm.c
+@@ -53,6 +53,7 @@
+     if (bytestream2_peek_byte(&p) == 1) {
+         bytestream2_skip(&p, 1);
+ 
++#ifndef MUSICFREE_AUDIO_PROFILE
+         if (bytestream2_peek_byte(&p) == 'v'){
+             int tag;
+             st->codecpar->codec_type = AVMEDIA_TYPE_VIDEO;
+@@ -67,6 +68,7 @@
+             st->codecpar->codec_id = AV_CODEC_ID_TEXT;
+             bytestream2_skip(&p, 12);
+         } else {
++#endif
+             uint8_t acid[5] = { 0 };
+             int cid;
+             st->codecpar->codec_type = AVMEDIA_TYPE_AUDIO;
+@@ -78,7 +80,9 @@
+             // our parser completely breaks AAC in Ogg
+             if (st->codecpar->codec_id != AV_CODEC_ID_AAC)
+                 sti->need_parsing = AVSTREAM_PARSE_FULL;
++#ifndef MUSICFREE_AUDIO_PROFILE
+         }
++#endif
+ 
+         size        = bytestream2_get_le32(&p);
+         size        = FFMIN(size, os->psize);
+@@ -92,11 +96,13 @@
+         bytestream2_skip(&p, 4);    /* default_len */
+         bytestream2_skip(&p, 8);    /* buffersize + bits_per_sample */
+ 
++#ifndef MUSICFREE_AUDIO_PROFILE
+         if(st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO){
+             st->codecpar->width = bytestream2_get_le32(&p);
+             st->codecpar->height = bytestream2_get_le32(&p);
+             avpriv_set_pts_info(st, 64, time_unit, spu * 10000000);
+         } else {
++#endif
+             st->codecpar->ch_layout.nb_channels = bytestream2_get_le16(&p);
+             bytestream2_skip(&p, 2); /* block_align */
+             st->codecpar->bit_rate = bytestream2_get_le32(&p) * 8;
+@@ -114,7 +120,9 @@
+                     return ret;
+                 bytestream2_get_buffer(&p, st->codecpar->extradata, st->codecpar->extradata_size);
+             }
++#ifndef MUSICFREE_AUDIO_PROFILE
+         }
++#endif
+ 
+         // Update internal avctx with changes to codecpar above.
+         sti->need_context_update = 1;
+@@ -127,6 +135,7 @@
+     return 1;
+ }
+ 
++#ifndef MUSICFREE_AUDIO_PROFILE
+ static int
+ ogm_dshow_header(AVFormatContext *s, int idx)
+ {
+@@ -167,6 +176,7 @@
+ 
+     return 1;
+ }
++#endif
+ 
+ static int
+ ogm_packet(AVFormatContext *s, int idx)
+@@ -192,6 +202,7 @@
+     return 0;
+ }
+ 
++#ifndef MUSICFREE_AUDIO_PROFILE
+ const struct ogg_codec ff_ogm_video_codec = {
+     .magic = "\001video",
+     .magicsize = 6,
+@@ -200,6 +211,7 @@
+     .granule_is_start = 1,
+     .nb_header = 2,
+ };
++#endif
+ 
+ const struct ogg_codec ff_ogm_audio_codec = {
+     .magic = "\001audio",
+@@ -210,6 +222,7 @@
+     .nb_header = 2,
+ };
+ 
++#ifndef MUSICFREE_AUDIO_PROFILE
+ const struct ogg_codec ff_ogm_text_codec = {
+     .magic = "\001text",
+     .magicsize = 5,
+@@ -227,3 +240,4 @@
+     .granule_is_start = 1,
+     .nb_header = 1,
+ };
++#endif
+
diff --git a/contrib/src/ffmpeg/rules.mak b/contrib/src/ffmpeg/rules.mak
index eda36c50f3..ce5e2b7e53 100644
--- a/contrib/src/ffmpeg/rules.mak
+++ b/contrib/src/ffmpeg/rules.mak
@@ -19,10 +19,6 @@ FFMPEGCONF = --prefix="$(PREFIX)" --enable-static --disable-shared \
 	--host-cc="$(BUILDCC)" \
 	--pkg-config="$(PKG_CONFIG)" \
 	--disable-doc \
-	--disable-encoder=vorbis \
-	--disable-decoder=opus \
-	--enable-libgsm \
-	--enable-libopenjpeg \
 	--disable-debug \
 	--disable-avdevice \
 	--disable-devices \
@@ -32,12 +28,46 @@ FFMPEGCONF = --prefix="$(PREFIX)" --enable-static --disable-shared \
 	--disable-bsfs \
 	--disable-bzlib \
 	--disable-libvpx \
-	--enable-bsf=vp9_superframe \
-	--disable-swresample \
 	--disable-iconv \
 	--disable-avisynth \
 	--disable-nvenc \
 	--disable-linux-perf
+
+ifndef MUSICFREE_AUDIO_PROFILE
+FFMPEGCONF += \
+	--disable-encoder=vorbis \
+	--disable-decoder=opus \
+	--enable-libgsm \
+	--enable-libopenjpeg \
+	--enable-bsf=vp9_superframe \
+	--disable-swresample
+DEPS_ffmpeg = zlib $(DEPS_zlib) gsm $(DEPS_gsm) openjpeg $(DEPS_openjpeg)
+else
+# The MusicFree profile uses FFmpeg only for the audio codecs and containers
+# that VLC does not provide as a smaller native module. VLC owns all network
+# access, so FFmpeg must not retain its own network or media-processing graph.
+FFMPEGCONF += \
+	--disable-everything \
+	--disable-avdevice \
+	--disable-devices \
+	--disable-avfilter \
+	--disable-filters \
+	--disable-encoders \
+	--disable-muxers \
+	--disable-bsfs \
+	--disable-network \
+	--disable-programs \
+	--disable-videotoolbox \
+	--enable-small \
+	--disable-swscale \
+	--extra-cflags=-DMUSICFREE_AUDIO_PROFILE \
+	--enable-protocol=file \
+	--enable-decoder='aac,aac_fixed,aac_latm,alac,ape,flac,mp3,mpc7,mpc8,opus,pcm_*,vorbis,wavpack' \
+	--enable-parser='aac,aac_latm,ac3,ape,flac,mpegaudio,opus,vorbis' \
+	--enable-demuxer='aac,adts,aiff,ape,caf,flac,matroska,mov,mp3,mpc,mpc8,ogg,pcm,wav,wv' \
+	--enable-swresample
+DEPS_ffmpeg = zlib $(DEPS_zlib)
+endif
 ifdef HAVE_DARWIN_OS
 FFMPEGCONF += \
 	--disable-securetransport
@@ -49,6 +79,12 @@ FFMPEGCONF += \
 endif
 endif
 
+ifdef MUSICFREE_AUDIO_PROFILE
+# Keep this define after the Darwin flags because FFmpeg's configure accepts
+# repeated --extra-cflags options and the later one wins.
+FFMPEGCONF += --extra-cflags="$(CFLAGS) -DMUSICFREE_AUDIO_PROFILE" --disable-videotoolbox
+endif
+
 ifdef ENABLE_PDB
 FFMPEGCONF += --ln_s=false
 endif
@@ -56,18 +92,21 @@ ifdef ENABLE_LTO
 FFMPEGCONF += --enable-lto
 endif
 
-DEPS_ffmpeg = zlib $(DEPS_zlib) gsm $(DEPS_gsm) openjpeg $(DEPS_openjpeg)
-
 # Optional dependencies
-ifndef BUILD_NETWORK
+ifndef MUSICFREE_AUDIO_PROFILE
+ifdef BUILD_NETWORK
+else
 FFMPEGCONF += --disable-network
 endif
+endif
+ifndef MUSICFREE_AUDIO_PROFILE
 ifdef BUILD_ENCODERS
 FFMPEGCONF += --enable-libmp3lame
 DEPS_ffmpeg += lame $(DEPS_lame)
 else
 FFMPEGCONF += --disable-encoders --disable-muxers
 endif
+endif
 
 ifneq ($(findstring amf,$(PKGS)),)
 DEPS_ffmpeg += amf $(DEPS_amf)
@@ -251,6 +290,7 @@ ffmpeg: ffmpeg-$(FFMPEG_VERSION).tar.xz .sum-ffmpeg
 	$(APPLY) $(SRC)/ffmpeg/0011-avcodec-videotoolboxenc-disable-calls-on-unsupported.patch
 	$(APPLY) $(SRC)/ffmpeg/avcodec-fix-compilation-visionos.patch
 	$(APPLY) $(SRC)/ffmpeg/avcodec-enable-audiotoolbox-ac3.patch
+	$(APPLY) $(SRC)/ffmpeg/musicfree-audio-only.patch
 	$(MOVE)
 
 .ffmpeg: ffmpeg

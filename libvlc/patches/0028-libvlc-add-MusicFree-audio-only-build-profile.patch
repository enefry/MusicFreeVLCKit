@@ -804,8 +804,17 @@ fi
 
 # Bootstrap VLC
 cd "$VLC_SRC_DIR" || abort_err "Failed cd to VLC source dir"
-if ! [ -e configure ]; then
-    echo "Bootstraping vlc"
+# Automake embeds the included modules/*.am files into modules/Makefile.in.
+# Checking configure.ac alone leaves a stale module graph after a profile
+# changes a Makefile.am, which can silently reintroduce video sources.
+needs_bootstrap=0
+if [ ! -e configure ]; then
+    needs_bootstrap=1
+elif find configure.ac modules -type f -name 'Makefile.am' -newer configure -print -quit | grep -q .; then
+    needs_bootstrap=1
+fi
+if [ "$needs_bootstrap" -eq 1 ]; then
+    echo "Bootstrapping vlc"
     ./bootstrap
 fi
 
@@ -871,12 +880,17 @@ elif [ "$VLC_HOST_OS" = "watchos" ]; then
     VLC_MODULE_REMOVAL_LIST+=( "${VLC_MODULE_REMOVAL_LIST_WATCHOS[@]}" )

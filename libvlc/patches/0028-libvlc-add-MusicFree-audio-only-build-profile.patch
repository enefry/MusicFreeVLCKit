+#include <vlc_objects.h>
+#include <vlc_picture.h>
+#include <vlc_picture_pool.h>
+#include <vlc_renderer_discovery.h>
+#include <vlc_subpicture.h>
+#include <vlc_vout.h>
+#include <vlc_vout_osd.h>
+#include <vlc_es.h>
+
+#include "input/resource.h"
+#include "player/player.h"
+#include "video_output/vout_internal.h"
+#include "misc/variables.h"
+
+typedef struct
+{
+    vout_thread_t obj;
+    vlc_atomic_rc_t refs;
+} musicfree_audio_vout_t;
+
+static musicfree_audio_vout_t *musicfree_audio_vout_new(vlc_object_t *parent)
+{
+    musicfree_audio_vout_t *vout = vlc_custom_create(parent, sizeof(*vout),
+                                                      "video output");
+    if (vout != NULL)
+        vlc_atomic_rc_init(&vout->refs);
+    return vout;
+}
+
+vout_thread_t *vout_CreateDummy(vlc_object_t *parent)
+{
+    musicfree_audio_vout_t *vout = musicfree_audio_vout_new(parent);
+    return vout != NULL ? &vout->obj : NULL;
+}
+
+vout_thread_t *vout_Create(vlc_object_t *parent)
+{
+    return vout_CreateDummy(parent);
+}
+
+vout_thread_t *vout_Hold(vout_thread_t *vout)
+{
+    if (vout != NULL)
+        vlc_atomic_rc_inc(&((musicfree_audio_vout_t *)vout)->refs);
+    return vout;
+}
+
+void vout_Release(vout_thread_t *vout)
+{
+    if (vout == NULL)
+        return;
+
+    musicfree_audio_vout_t *state = (musicfree_audio_vout_t *)vout;
+    if (vlc_atomic_rc_dec(&state->refs))
+        vlc_object_delete(vout);
+}
+
+void vout_Close(vout_thread_t *vout)
+{
+    vout_Stop(vout);
+    vout_Release(vout);
+}

+/*
+ * Audio-profile compatibility layer.
+ *
+ * The normal libVLC core shares a number of video-oriented control paths with
+ * audio playback. The audio profile removes the video output implementation,
+ * so these entry points deliberately fail closed or discard video data.
+ */
+
+#ifdef HAVE_CONFIG_H

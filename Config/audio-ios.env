# MusicFree audio-only VLCKit profile.
# This file is sourced by libvlc/extras/package/apple/build.sh.

export MUSICFREE_AUDIO_PROFILE=1
export MUSICFREE_VLC_DEPLOYMENT_TARGET="15.0"
export VLC_AUDIO_PROFILE_CFLAGS="-DMUSICFREE_AUDIO_PROFILE -fvisibility=hidden"

# The MusicFree release is an iOS-only artifact. Keep its device and simulator
# slices on the same iOS 15 baseline while building with the current SDK.
export VLC_DEPLOYMENT_TARGET_MACOSX="26.0"
export VLC_DEPLOYMENT_TARGET_IOS="15.0"
export VLC_DEPLOYMENT_TARGET_IOS_SIMULATOR="15.0"
export VLC_DEPLOYMENT_TARGET_TVOS="26.0"
export VLC_DEPLOYMENT_TARGET_TVOS_SIMULATOR="26.0"
export VLC_DEPLOYMENT_TARGET_XROS="26.0"
export VLC_DEPLOYMENT_TARGET_WATCHOS="26.0"

# Start with no optional contrib package. The explicit list is the complete
# package allowlist for this profile; dependencies are resolved by contrib.
export VLC_CONTRIB_OPTIONS_BASE=(
    --disable-all
    --disable-gpl
    --disable-gnuv3
    --enable-ad-clauses
    --disable-sout
    --disable-disc
    --enable-ffmpeg
